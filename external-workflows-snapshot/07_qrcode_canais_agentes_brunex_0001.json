    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  const r = item.json;\n  const urlBase = String(r.url_canal || '').trim();\n  const numero = String(r.identificador_externo || '').replace(/\\D/g, '');\n  const wa = urlBase || (numero ? `https://wa.me/${numero}` : '');\n  const qr = wa ? `https://api.qrserver.com/v1/create-qr-code/?size=800x800&data=${encodeURIComponent(wa)}` : '';\n  return {\n    json: {\n      ...r,\n      wa_link: wa,\n      qr_code_url: qr\n    }\n  };\n});"
      },
      "id": "ddc8355e-b034-49ec-8d2f-4693269f5c49",
      "name": "Montar Links QRCode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update canais_integracao set url_canal = '{{$json.wa_link}}', metadata = coalesce(metadata, '{}'::jsonb) || jsonb_build_object('qr_code_url', '{{$json.qr_code_url}}', 'qr_code_gerado_em', now()::text, 'exibir_em_qrcode', true), atualizado_em = now() where id = '{{$json.id}}'::uuid returning id, id_candidato, nome_canal, tipo_canal, identificador_externo, url_canal, metadata, atualizado_em;",
        "options": {}
      },
      "id": "1e1c3db7-68c3-45b4-a8c2-0ccf7cdae4b0",
