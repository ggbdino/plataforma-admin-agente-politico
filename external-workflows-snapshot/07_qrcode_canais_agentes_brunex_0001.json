        "query": "select id, id_candidato, nome_canal, tipo_canal, identificador_externo, url_canal, metadata from canais_integracao where status = 'ativo' and id_candidato = '0001' and tipo_canal = 'whatsapp_agente' and coalesce((metadata ->> 'exibir_em_qrcode')::boolean, false) = true order by atualizado_em desc;",
