        "jsCode": "return items.map((item) => {\n  const r = item.json.body || item.json;\n  const origem = r.origem || r.utm_source || 'nao_informada';\n  const interesse = (r.tema_interesse || r.interesse || '').toLowerCase();\n  const score = r.score_inicial || (origem.includes('evento') ? 35 : origem.includes('whatsapp') ? 30 : 20);\n  return {\n    json: {\n      eleitor_id: r.eleitor_id || r.telefone || r.email || Date.now().toString(),\n      nome: r.nome || 'nao informado',\n      telefone: r.telefone || '',\n      origem_captacao: origem,\n      cidade: r.cidade || '',\n      bairro: r.bairro || '',\n      tema_interesse: interesse || 'geral',\n      consentimento_lgpd: !!r.consentimento_lgpd,\n      etapa_funil: 'novo_lead',\n      score_engajamento: score,\n      score_propensao_voto: 0,\n      canal_preferido: r.canal_preferido || 'whatsapp'\n    }\n  };\n});"
      },
